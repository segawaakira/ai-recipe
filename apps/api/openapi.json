  "info": {
    "title": "Ai recipe API",
    "description": "Ai recipe API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password1",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "DeleteUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "CreateIngredientDto": {
        "type": "object",
        "properties": {
          "ingredients": {
            "example": [
              "tomato",
              "onion",
              "garlic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ingredients"
        ]
      },
      "IngredientSetResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "ingredients": {
            "example": [
              "tomato",
              "onion",
              "garlic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "userId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "id",
          "ingredients",
          "createdAt",
          "userId"
        ]
      },
      "UpdateIngredientDto": {
        "type": "object",
        "properties": {
          "ingredients": {
            "example": [
              "tomato",
              "onion",
              "garlic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ingredients"
        ]
      },
      "CreateRecipeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "トマトパスタ"
          },
          "content": {
            "type": "string",
            "example": "## トマトパスタの作り方\n..."
          },
          "ingredients": {
            "example": [
              "トマト",
              "玉ねぎ",
              "にんにく"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "servings": {
            "type": "number",
            "example": 2
          },
          "genre": {
            "type": "string",
            "example": "和食",
            "nullable": true
          },
          "youtubeVideos": {
            "type": "object",
            "example": [
              {
                "videoId": "abc",
                "title": "Recipe video",
                "channelTitle": "Channel",
                "thumbnail": "https://..."
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "name",
          "content",
          "ingredients",
          "servings"
        ]
      },
      "RecipeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "トマトパスタ"
          },
          "content": {
            "type": "string",
            "example": "## トマトパスタの作り方\n..."
          },
          "ingredients": {
            "example": [
              "トマト",
              "玉ねぎ",
              "にんにく"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "servings": {
            "type": "number",
            "example": 2
          },
          "genre": {
            "type": "string",
            "example": "和食",
            "nullable": true
          },
          "youtubeVideos": {
            "type": "object",
            "example": null,
            "nullable": true
          },
          "rating": {
            "type": "number",
            "example": null,
            "nullable": true,
            "description": "1-5の5段階評価、未評価はnull"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "userId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "id",
          "name",
          "content",
          "ingredients",
          "servings",
          "createdAt",
          "userId"
        ]
      },
      "PaginatedRecipeResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeResponseDto"
            }
          },
          "total": {
            "type": "number",
            "example": 10
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "UpdateRecipeRatingDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "example": 4,
            "description": "1-5の5段階評価"
          }
        },
        "required": [
          "rating"
        ]
      },
      "RatedRecipeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "rating"
        ]
      },
      "GenerateRecipeDto": {
        "type": "object",
        "properties": {
          "preferredIngredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allIngredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "servings": {
