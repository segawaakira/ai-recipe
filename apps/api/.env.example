PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# OpenAPIのドキュメントのBASIC認証情報
SWAGGER_USER=
SWAGGER_PASSWORD=

# gemini api key
GEMINI_API_KEY=
# youtube data apiを使うのに必要
YOUTUBE_API_KEY=

# 任意の長いランダム文字列（例: openssl rand -hex 32 で生成）
JWT_SECRET=

# CORS許可オリジン（カンマ区切りで複数指定可）
CORS_ORIGIN=http://localhost:3000

# Gmail SMTP（アプリパスワード）
SMTP_USER=your-email@gmail.com
SMTP_PASS=

# フロントエンドURL（メール認証リンクに使用）
FRONTEND_URL=http://localhost:3000

# メール送信元アドレス（省略時はSMTP_USERが使用される）
EMAIL_FROM=